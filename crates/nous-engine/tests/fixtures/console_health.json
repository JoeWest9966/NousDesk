 "maintenance": [
  {
   "label": "先做一次备份",
   "why": "改动任何东西之前，先把库整份复制走 —— VACUUM 也是写操作。",
   "cmd": "cp \"/opt/Nous/content/new1/map/qrd3wh/data/agent.sqlite\" \"/opt/Nous/content/new1/map/qrd3wh/data/agent.sqlite.$(date +%Y%m%d-%H%M).bak\"",
   "danger": false
  },
  {
   "label": "把 WAL 收回去",
   "why": "WAL 现在 475 KB。checkpoint 只读的页面做不了，得由写者或 sqlite3 来。",
   "cmd": "sqlite3 \"/opt/Nous/content/new1/map/qrd3wh/data/agent.sqlite\" \"PRAGMA wal_checkpoint(TRUNCATE);\"",
   "danger": false
  },
  {
   "label": "VACUUM 要回空闲页",
   "why": "空闲页 1 个（4.0 KB）。这块停止服务后再跑 —— 它要独占写者。",
   "cmd": "sqlite3 \"/opt/Nous/content/new1/map/qrd3wh/data/agent.sqlite\" \"VACUUM;\"",
   "danger": false
  },
  {
   "label": "看它到底是不是好的",
   "why": "integrity_check 会把整库走一遍；库大了要几分钟。",
   "cmd": "sqlite3 \"/opt/Nous/content/new1/map/qrd3wh/data/agent.sqlite\" \"PRAGMA integrity_check;\"",
   "danger": false
  },
  {
   "label": "把老会话搬去 storage-Archive",
   "why": "先导出、再删。别直接 DELETE —— 那等于把历史删掉，而不是归档。",
   "cmd": "sqlite3 \"/opt/Nous/content/new1/map/qrd3wh/data/agent.sqlite\" \".dump conversations entries tasks submissions\" > conversations-$(date +%F).sql",
   "danger": true
  }
 ],
