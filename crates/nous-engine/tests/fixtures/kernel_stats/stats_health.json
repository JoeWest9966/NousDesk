  "maintenance": [
    {
      "label": "先做一次备份",
      "why": "改动任何东西之前，先把库整份复制走 —— VACUUM 也是写操作。",
      "cmd": "cp \"fixtures/agent.small.sqlite\" \"fixtures/agent.small.sqlite.$(date +%Y%m%d-%H%M).bak\"",
      "danger": false
    },
    {
      "label": "把 WAL 收回去",
      "why": "WAL 现在 0 字节。checkpoint 只读的页面做不了，得由写者或 sqlite3 来。",
      "cmd": "sqlite3 \"fixtures/agent.small.sqlite\" \"PRAGMA wal_checkpoint(TRUNCATE);\"",
      "danger": false
    },
    {
      "label": "VACUUM 要回空闲页",
      "why": "空闲页 0 个（0 字节）。这块停止服务后再跑 —— 它要独占写者。",
      "cmd": "sqlite3 \"fixtures/agent.small.sqlite\" \"VACUUM;\"",
      "danger": false
    },
    {
      "label": "看它到底是不是好的",
      "why": "integrity_check 会把整库走一遍；库大了要几分钟。",
      "cmd": "sqlite3 \"fixtures/agent.small.sqlite\" \"PRAGMA integrity_check;\"",
      "danger": false
    }
  ]
